# Application
ENVIRONMENT=development
APP_NAME="Voice Splitwise Backend"
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","*"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicesplitwise
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/voicesplitwise

# AI Models & Google GenAI
# If using Vertex AI:
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=your-gemini-api-key-here

# Model Names
STAGE1_MODEL=gemini-3.8-flash
STAGE2_MODEL=gemini-4-hydrogen

# Seed User Mock Auth
DEFAULT_USER_EMAIL=testuser@example.com
DEFAULT_USER_NAME="Test User"

# Firebase Auth Configuration
# Option A (Local): Place your downloaded service account JSON in root as firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option B (Render / Cloud): Paste raw service account JSON string into environment variable
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=your-firebase-project-id

# Server Port
PORT=8000
